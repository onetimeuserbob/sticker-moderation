# --- Anthropic (workhorse: IP/PII/NSFW judgement on images + text) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- OpenAI (free pre-filter via omni-moderation-latest) ---
# Set to enable cheap first-pass NSFW/violence/etc. filtering.
# If unset, pipeline runs Claude on every pack (still fine, just costlier).
OPENAI_API_KEY=

# --- Telegram Bot API (only needed for Phase 2: individual stickers) ---
# Create via @BotFather: /newbot -> pick name -> paste token here.
# No separate Telegram account needed beyond the one you create the bot from.
# Phase 1 (logo + cover only) does NOT need this.
TELEGRAM_BOT_TOKEN=

# --- Review Bot (the live moderation bot listening in chats) ---
# Separate token from above. The pipeline bot fetches sticker thumbnails;
# this bot listens for applications and posts approve/reject suggestions.
REVIEW_BOT_TOKEN=
# Username (without @) of the bot that posts the applications we review.
SOURCE_BOT_USERNAME=sticker_bot
# The single owner user id. Only this user can DM the bot, add it to chats,
# edit rules, and learn from disagreements. REQUIRED — do not deploy without.
OWNER_USER_ID=
# Optional pre-seeded chat ids (comma-separated). Normally leave empty: the
# allowlist auto-fills with chats the owner adds the bot to.
ALLOWED_CHAT_IDS=
# Where the runtime allowlist is persisted.
ALLOWLIST_PATH=.allowed_chats.json

# --- Tuning ---
# Per-pack image cap fed to Claude (cost driver).
MAX_IMAGES_PER_PACK=12

# Decision thresholds.
CLAUDE_RED_THRESHOLD=70
CLAUDE_YELLOW_THRESHOLD=35
COMBINED_RED=70
COMBINED_YELLOW=35

# OpenAI moderation thresholds. omni-moderation returns 0-1 per category.
# If any category exceeds this, treat as a hard signal.
OPENAI_HARD_THRESHOLD=0.85
OPENAI_SOFT_THRESHOLD=0.5

# --- Concurrency ---
PACK_WORKERS=4
